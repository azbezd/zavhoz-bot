# Обязательные
TELEGRAM_BOT_TOKEN=replace-me
OPENAI_API_KEY=replace-me
# Telegram user id через запятую. Пусто = бот никому не отвечает.
ALLOWED_TELEGRAM_USER_IDS=123456789

# Необязательные
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
INVENTORY_ENABLE_WEB_SEARCH=1
INVENTORY_DB=./data/inventory.db
INVENTORY_REPO_DIR=./data
INVENTORY_AUTO_GIT=0
# Адрес вашего каталога (ссылки из ответов бота ведут сюда)
ZAVHOZ_SITE_BASE=https://azbezd.github.io/zavhoz-web
# Если OpenAI недоступен из вашей сети:
# HTTPS_PROXY=http://127.0.0.1:8888
