[Unit]
Description=FreeNet Inventory Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/freenet-inventory-bot.env
WorkingDirectory=/opt/zavhoz/zavhoz-bot
ExecStart=/usr/bin/python3 -m inventory_bot.bot
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/zavhoz /opt/freenet-inventory-bot

[Install]
WantedBy=multi-user.target
